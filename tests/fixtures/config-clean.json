{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21"],
      "env": {}
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git==2025.9.1"],
      "env": {}
    },
    "weather": {
      "url": "https://mcp.weather.example.com/mcp",
      "env": {
        "WEATHER_API_TOKEN": "${WEATHER_API_TOKEN}"
      }
    }
  }
}
